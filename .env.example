# App identity. Keep these stable after the first TestFlight build/App Store Connect record.
EXPO_PUBLIC_APP_NAME=Tekomi Chat
EXPO_PUBLIC_APP_SLUG=tekomi-chat
EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER=vn.tekomi.chat
EXPO_PUBLIC_ANDROID_PACKAGE=vn.tekomi.chat

# Chatwoot deployment and existing optional integrations.
EXPO_PUBLIC_CHATWOOT_WEBSITE_TOKEN=
EXPO_PUBLIC_CHATWOOT_BASE_URL=https://app.chatwoot.com
EXPO_PUBLIC_MINIMUM_CHATWOOT_VERSION=4.1.0
EXPO_PUBLIC_JUNE_SDK_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_PROJECT_NAME=
EXPO_PUBLIC_SENTRY_ORG_NAME=
EXPO_STORYBOOK_ENABLED=false

# Expo account/organization and public EAS project ID. These defaults are the Tekomi project
# created by `eas init`; override only when making another EAS project/environment.
EXPO_PUBLIC_EAS_OWNER=tekomi
EXPO_PUBLIC_PROJECT_ID=894d87f0-3956-43f2-86c4-d14684c0b492
EXPO_APPLE_ID=
EXPO_APPLE_TEAM_ID=

# Set only after this host has apple-app-site-association and assetlinks.json configured.
EXPO_PUBLIC_APP_LINK_HOST=

# New Firebase project files registered under the Tekomi bundle/package IDs.
# Local paths; on EAS, upload each as a Secret File variable with the same name.
IOS_GOOGLE_SERVICES_FILE=./GoogleService-Info.plist
ANDROID_GOOGLE_SERVICES_FILE=./google-services.json
